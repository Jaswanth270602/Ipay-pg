APP_NAME="Payment Gateway"
APP_ENV=local
APP_KEY=base64:cwQ2coXbBFcDgEFWZrjSLu0e2OLhzk16sVwHfOe4DaA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=badilicash_testdb
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@badlicash.test"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateway configuration
# mode: test = internal simulation only, live = use Razorpay/Cashfree acquirers
APP_PAYMENT_MODE=live
APP_PAYMENT_API_VERSION=v1
APP_PAYMENT_FEE_PERCENTAGE=2.5
APP_PAYMENT_FEE_FLAT=0.30
APP_PAYMENT_DEFAULT_CURRENCY=USD

# Bank Provider Configuration
BANK_PROVIDER_SANDBOX_URL=http://localhost/api/sandbox/bank
BANK_PROVIDER_LIVE_URL=https://api.bank-provider.com
BANK_PROVIDER_API_KEY=
BANK_PROVIDER_API_SECRET=

# Webhook Configuration
WEBHOOK_MAX_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_SECONDS=60

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# Security
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000

# Pagination
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# Logging
TURNONLOGS=false

# Yapily Sandbox (dummy bank / open-banking testing only).
# Set to false to disable; routes return 403.
ENABLE_YAPILY_SANDBOX=true
YAPILY_BASE_URL=https://api.yapily.com

# Yapily credentials are now stored ONLY in the AcquirerAccount database table
# (e.g. Additional Key 1 / Additional Key 2) and are not read from .env.

# Optional: test API key for payment:create-test command (leave empty to use first test key)
# TEST_MERCHANT_API_KEY=

